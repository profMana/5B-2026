{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "name": "tsx watch",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "restart": true,
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "tsx",
                "watch",
                "--inspect", // serve a mantenere i breakpoint tra un riavvio e l'altro
                "server.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },
        {
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "name": "tsx no watch",
            "cwd": "${workspaceFolder}",
            "request": "launch",
            "restart": true,
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "tsx",
                "server.ts"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "type": "node"
        },

    ]
}